<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="640.0" prefWidth="960.0" spacing="18.0" styleClass="title-screen"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unicam.cs.mpgc.rpg130809.controller.ui.TitleScreenController">
   <Button fx:id="newGameButton" onAction="#onNewGameButtonClicked" mnemonicParsing="false" styleClass="title-screen-menu-button, title-screen-new-game-button" text="Nuova Partita"/>
   <Button fx:id="loadGameButton" mnemonicParsing="false" styleClass="title-screen-menu-button, title-screen-load-game-button" text="Continua Partita"/>
   <Button onAction="#onExitGameButtonClicked" mnemonicParsing="false" styleClass="title-screen-menu-button, title-screen-exit-button" text="Esci dal Gioco"/>
</VBox>
