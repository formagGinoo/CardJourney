<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="640.0" prefWidth="960.0"
           styleClass="victory-root"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg130809.controller.ui.VictoryViewController">
    <ImageView fitHeight="640.0" fitWidth="960.0" preserveRatio="true" styleClass="victory-backdrop">
        <Image url="@../img/victoryview/victory_bg.jpg"/>
    </ImageView>
    <VBox alignment="CENTER" maxWidth="420.0" spacing="10.0" styleClass="victory-panel">
        <Label styleClass="victory-title" text="VITTORIA!" />
        <ImageView fx:id="victorySprite" fitHeight="96.0" fitWidth="96.0" preserveRatio="true" styleClass="victory-sprite" />
        <Label fx:id="victorySubtitle" maxWidth="380.0" wrapText="true" styleClass="victory-subtitle" />
        <HBox alignment="CENTER" spacing="10.0" styleClass="victory-stats">
            <Label fx:id="victoryPlayerHp" styleClass="victory-stat, victory-hp" />
            <Label fx:id="victoryPlayerGold" styleClass="victory-stat, victory-gold" />
            <Label fx:id="victoryPlayerDeck" styleClass="victory-stat, victory-deck" />
        </HBox>
        <HBox alignment="CENTER" styleClass="victory-actions">
            <Button fx:id="victoryButton" mnemonicParsing="false" onAction="#onVictoryButtonClicked"
                    styleClass="victory-button" text="Torna al Menu" />
        </HBox>
    </VBox>
</StackPane>
